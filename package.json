{
  "name": "council-onepager",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A browser-based editor for clear, source-backed municipal decision briefs.",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=22.23.2"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "schema:generate": "node --import tsx tools/export-schema.ts",
    "schema:check": "node --import tsx tools/export-schema.ts --check",
    "check": "pnpm schema:check && pnpm build && pnpm test && pnpm lint && pnpm format:check"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.10.0",
    "globals": "17.12.0",
    "prettier": "3.9.8",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  }
}
